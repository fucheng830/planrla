---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import Download from '../components/Download.astro';
import Waitlist from '../components/Waitlist.astro';
import Changelog from '../components/Changelog.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Planrla — 让 AI 编码智能体定时干活"
  description="多 CLI 工作台(Claude/Codex/Cursor/Gemini/Kimi/ZCode):定时任务、停机补跑、原会话续跑保留上下文,干完推送到手机。本地优先,数据不离机。"
>
  <Nav />
  <main>
    <Hero />
    <Features />
    <Pricing />
    <Download />
    <Waitlist />
    <Changelog />
  </main>
  <Footer />
</Base>
