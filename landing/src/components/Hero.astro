---
// Hero — scheduled-agents positioning (2026-10):
// "agents run on a schedule while you sleep; results land on your phone."
// The control-room framing stays for the secondary line.
const providers = ['Claude', 'Codex', 'Gemini', 'Cursor', 'Kimi', 'GLM'];
---
<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-title">让 AI 编码智能体<br /><span>定时干活</span></h1>
    <p class="hero-sub">你睡觉,它在跑任务:定时执行、错过补跑、原会话续跑保留全部上下文,<br />干完推送到你手机。需要你时,点一下批准,任务继续。</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="#waitlist">加入 Beta</a>
      <a class="btn btn-ghost" href="#download">下载桌面版</a>
    </div>

    <div class="hero-visual" role="img" aria-label="手机收到推送:Claude 需要批准,点批准后任务继续">
      <div class="phone-card">
        <div class="notif">
          <div class="notif-head">
            <img src="/logo.svg" alt="" width="18" height="18" />
            <span class="notif-app">Planrla</span>
            <span class="notif-time">现在</span>
          </div>
          <div class="notif-title">Claude 需要你的批准</div>
          <div class="notif-body">Bash · npm install -g serve</div>
          <div class="notif-actions">
            <span class="pill pill-approve">批准</span>
            <span class="pill pill-deny">拒绝</span>
          </div>
        </div>
        <div class="notif notif-dim">
          <div class="notif-head">
            <img src="/logo.svg" alt="" width="18" height="18" />
            <span class="notif-app">Planrla</span>
            <span class="notif-time">2 分钟前</span>
          </div>
          <div class="notif-title">任务完成 ✓</div>
          <div class="notif-body">会话「重构登录模块」已结束,点击查看改动</div>
        </div>
      </div>
    </div>

    <div class="hero-providers">
      {providers.map((p) => <span class="provider-chip">{p}</span>)}
    </div>
  </div>
</section>

<style>
  .hero { padding: 88px 0 64px; text-align: center; }
  .hero-inner { max-width: 760px; }
  .hero-title { font-size: 46px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; margin: 0 0 20px; }
  .hero-title span { color: var(--color-primary); }
  .hero-sub { font-size: 17px; color: var(--color-muted); margin: 0 0 30px; line-height: 1.7; }
  .hero-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn { display: inline-block; padding: 12px 22px; border-radius: var(--radius); font-weight: 600; font-size: 15px; transition: background .15s; }
  .btn-primary { background: var(--color-primary); color: var(--color-primary-fg); }
  .btn-primary:hover { background: var(--color-primary-hover); }
  .btn-ghost { border: 1px solid var(--color-border); color: var(--color-fg); }
  .btn-ghost:hover { background: var(--color-surface); }

  .hero-visual { display: flex; justify-content: center; margin: 44px 0 8px; }
  .phone-card {
    width: 320px; padding: 14px 12px;
    border-radius: 24px;
    background: linear-gradient(160deg, #1c2027, #10131a);
    box-shadow: 0 24px 60px rgba(15, 23, 42, .28);
    display: flex; flex-direction: column; gap: 10px;
  }
  .notif { background: rgba(255,255,255,.96); border-radius: 16px; padding: 12px 14px; text-align: left; }
  .notif-dim { opacity: .72; }
  .notif-head { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
  .notif-app { font-size: 11px; font-weight: 700; color: #333; }
  .notif-time { margin-left: auto; font-size: 10px; color: #999; }
  .notif-title { font-size: 14px; font-weight: 700; color: #111; margin-bottom: 2px; }
  .notif-body { font-size: 12px; color: #555; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .notif-actions { display: flex; gap: 8px; margin-top: 10px; }
  .pill { font-size: 12px; font-weight: 700; padding: 6px 16px; border-radius: 999px; }
  .pill-approve { background: var(--color-primary); color: var(--color-primary-fg); }
  .pill-deny { background: #eef0f3; color: #444; }

  .hero-providers { display: flex; gap: 8px; justify-content: center; margin-top: 32px; flex-wrap: wrap; }
  .provider-chip { font-size: 12px; font-weight: 600; color: var(--color-muted); background: var(--color-surface-2); padding: 5px 12px; border-radius: 999px; }

  @media (max-width: 640px) {
    .hero { padding: 56px 0 44px; }
    .hero-title { font-size: 32px; }
    .hero-sub { font-size: 15px; }
    .phone-card { width: 280px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .notif:not(.notif-dim) { animation: notif-pulse 2.6s ease-in-out infinite; }
    @keyframes notif-pulse { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
  }
</style>
