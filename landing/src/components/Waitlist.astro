---
// Waitlist — 邮箱捕获,POST 到 api.planrla.com/api/waitlist(worker 落 D1)。
// 重复邮箱幂等(主键 upsert),前端只做轻校验 + 状态提示。
---
<section class="waitlist" id="waitlist">
  <div class="container waitlist-inner">
    <h2 class="waitlist-title">加入 Beta</h2>
    <p class="waitlist-sub">首批名额有限。留下邮箱,开通和发布通知第一时间到达——仅此用途。</p>
    <form class="waitlist-form" id="waitlist-form">
      <input
        class="waitlist-input"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        aria-label="邮箱地址"
      />
      <button class="btn" type="submit" id="waitlist-submit">提交</button>
    </form>
    <p class="waitlist-status" id="waitlist-status" role="status"></p>
  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const status = document.getElementById('waitlist-status') as HTMLElement | null;
  const submit = document.getElementById('waitlist-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submit) return;
    const email = new FormData(form).get('email');
    if (typeof email !== 'string' || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      status.textContent = '请输入有效的邮箱地址。';
      status.className = 'waitlist-status error';
      return;
    }
    submit.disabled = true;
    status.textContent = '提交中…';
    status.className = 'waitlist-status';
    try {
      const res = await fetch('https://api.planrla.com/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'landing' }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      status.textContent = '已收到!我们会在首批名额开放时邮件联系你。';
      status.className = 'waitlist-status ok';
      form.reset();
    } catch {
      status.textContent = '提交失败,请稍后重试。';
      status.className = 'waitlist-status error';
    } finally {
      submit.disabled = false;
    }
  });
</script>

<style>
  .waitlist { padding: 64px 0; border-top: 1px solid var(--color-border); }
  .waitlist-inner { max-width: 560px; text-align: center; }
  .waitlist-title { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; margin: 0 0 8px; }
  .waitlist-sub { color: var(--color-muted); font-size: 15px; margin: 0 0 24px; }
  .waitlist-form { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .waitlist-input {
    flex: 1; min-width: 240px; max-width: 360px;
    padding: 11px 14px; border-radius: var(--radius);
    border: 1px solid var(--color-border); font-size: 14px; background: var(--color-surface);
  }
  .btn { padding: 11px 22px; border-radius: var(--radius); border: none; background: var(--color-primary); color: var(--color-primary-fg); font-weight: 600; font-size: 14px; cursor: pointer; }
  .btn:hover { background: var(--color-primary-hover); }
  .btn:disabled { opacity: .6; cursor: default; }
  .waitlist-status { min-height: 20px; margin: 14px 0 0; font-size: 13px; color: var(--color-muted); }
  .waitlist-status.ok { color: #059669; font-weight: 600; }
  .waitlist-status.error { color: #dc2626; }
</style>
