# nomad Environment Configuration
# Only includes variables that are actually used in the code
#
# TIP: Run 'nomad status' to see where this file should be located
#      and to view your current configuration.
#
# Available CLI commands:
#   claude-code-ui    - Start the server (default)
#   nomad start    - Start the server
#   nomad status   - Show configuration and data locations
#   nomad help     - Show help information
#   nomad version  - Show version information

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (Express API + WebSocket server)
#API server
SERVER_PORT=3001
#Frontend port
VITE_PORT=5173

# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# Uncomment the following line if you have a custom claude cli path other than the default "claude"
# CLAUDE_CLI_PATH=claude

# =============================================================================
# COMMERCIAL LICENSING
# =============================================================================

# Public key used to verify offline commercial license keys.
# Use a PEM public key with newlines escaped as \n when stored in an env file.
# NOMAD_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional pre-provisioned license key. If unset, admins can activate a key in Settings > License.
# NOMAD_LICENSE_KEY=nomad_payload.signature

# When true, protected APIs require an active commercial license.
# NOMAD_REQUIRE_LICENSE=false

# Development-only bypass. Do not enable in production.
# NOMAD_LICENSE_BYPASS=false

# =============================================================================
# COMMERCIAL UPDATES
# =============================================================================

# JSON endpoint used by the web UI to check for updates.
# Expected fields: version, title, body, htmlUrl, publishedAt.
# NOMAD_UPDATE_CHECK_URL=https://updates.nomad.ai/desktop/latest.json

# Generic provider URL used by Electron auto-updater.
# NOMAD_UPDATE_URL=https://updates.nomad.ai/desktop

# Electron signing variables are read by electron-builder:
# Windows: CSC_LINK, CSC_KEY_PASSWORD
# macOS: CSC_LINK, CSC_KEY_PASSWORD, APPLE_ID, APPLE_APP_SPECIFIC_PASSWORD, APPLE_TEAM_ID

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to the authentication database file
# This is where user credentials, API keys, and tokens are stored.
#
# To use a custom location:
# DATABASE_PATH=/path/to/your/custom/auth.db
#
# Claude Code context window size (maximum tokens per session)
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000


